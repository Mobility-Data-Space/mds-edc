{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/mobility-dataspace/connector/schema/asset-v1.json",
  "title": "MDS Asset",
  "description": "Semantic constraints on MDS Asset properties. Applies to the expanded JSON-LD form of an Asset.",
